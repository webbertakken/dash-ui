{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,

    // This package SHIPS ITS SOURCE, so a consumer compiles these files
    // with ITS OWN compiler options, not ours. Checking them here under
    // the strictest flags a consumer is likely to run is the only thing
    // that stops the package breaking someone else's build at a path
    // they cannot edit: an unchecked index read in `topology-layout.ts`
    // is an error in THEIR repo, inside their node_modules.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  // The `.ts` surface only, which is exactly the set that can break a
  // consumer: their `svelte-check` never descends into a `.svelte` file
  // inside node_modules, but it DOES pull every reachable `.ts` into its
  // program. The components stay covered by this package's own tests and
  // by `apps/dashboard-svelte`; checking them here would also drag in
  // `@w5-ui/svelte`'s 262 unrelated strict-mode errors.
  "include": ["src/**/*.ts"]
}
